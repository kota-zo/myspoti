<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to the phone's own loopback address, for metadata scripts served from the
     computer through adb reverse (base/catalog/UPDATES.md). Everything else stays HTTPS, as in the other builds. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
