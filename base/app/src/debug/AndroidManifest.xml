<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug builds only: plain HTTP to localhost (res/xml/network_security_config.xml), nowhere else. -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Debug builds only: tools/playback_test.py drives the player through it. DUMP is held
             by the adb shell, not by other apps. -->
        <receiver
            android:name="com.music.spotui.di.TestControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.myspoti.TEST" />
            </intent-filter>
        </receiver>
        <!-- Debug builds only: the Connect consent page on its own (see ConsentProbeActivity). -->
        <activity
            android:name="com.music.spotui.connect.ConsentProbeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/Theme.Orpheon" />
        <!-- Debug builds only: the queue panel over a made-up queue (see QueueProbeActivity). -->
        <activity
            android:name="com.music.spotui.di.QueueProbeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/Theme.Orpheon" />
    </application>
</manifest>
